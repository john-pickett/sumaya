{
  "name": "meditation",
  "version": "1.2.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "bump": "node bump-version.js && npm run commit:version",
    "bump:minor": "node bump-version.js minor && npm run commit:version",
    "bump:major": "node bump-version.js major && npm run commit:version",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "build:ios:dev": "npm run bump && APP_VARIANT=development eas build --profile development --platform ios --local",
    "build:android:dev": "APP_VARIANT=development eas build --profile development --platform android --local",
    "build:ios:sim": "APP_VARIANT=development eas build --profile development-simulator --platform ios --local",
    "build:ios:prod": "npm run bump && eas build --profile production --platform ios --local",
    "build:android:prod": "eas build --profile production --platform android --local",
    "commit:version": "git add package.json app.json && git commit -m \"chore: bump to $(node -p \"require('./package.json').version\")\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.8",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-notifications": "~0.32.12",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
